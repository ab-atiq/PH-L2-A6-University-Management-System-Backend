  "item": [
    {
      "name": "Auth",
      "description": "Authentication: register, login, refresh, logout, Google OAuth.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "description": "Self-registration. Defaults to STUDENT role. Triggers an email-verification flow on the backend.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.student@student.university.edu\",\n  \"password\": \"Passw0rd!123\",\n  \"firstName\": \"New\",\n  \"lastName\": \"Student\",\n  \"phone\": \"+8801700000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data) {",
                  "  if (res.data.accessToken) pm.collectionVariables.set('accessToken', res.data.accessToken);",
                  "  if (res.data.refreshToken) pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "  if (res.data.user && res.data.user.id) pm.collectionVariables.set('userId', res.data.user.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
